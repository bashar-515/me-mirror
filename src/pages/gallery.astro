---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";

const { title, description } = {
  title: "bashar | gallery",
  description: "",
};

const photos = Object.values(
  import.meta.glob<ImageMetadata>("/src/assets/photos/jpg/*.jpg", {
    eager: true,
    import: "default",
  }),
).toSorted(() => Math.random() - 0.5);
---

<Layout title={title} description={description}>
  <div
    class="columns-1 gap-0 sm:columns-2 md:columns-3 lg:columns-4 xl:columns-5 2xl:columns-6"
  >
    {
      photos.map((photo) => (
        <a
          href={photo.src}
          target="_blank"
          rel="noopener"
          class="group grid break-inside-avoid"
        >
          <Image src={photo} alt="" class="col-start-1 row-start-1" />
          <div class="col-start-1 row-start-1 group-hover:bg-black/50 group-active:bg-black/50 dark:group-hover:bg-white/50 dark:group-active:bg-white/50" />
        </a>
      ))
    }
  </div>
</Layout>
