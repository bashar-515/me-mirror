---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";

const { title, description } = {
  title: "bashar | gallery",
  description: "",
};

const photos = Object.values(
  import.meta.glob<ImageMetadata>("/src/assets/photos/jpg/*.jpg", {
    eager: true,
    import: "default",
  }),
).toSorted(() => Math.random() - 0.5);
---

<Layout title={title} description={description}>
  {
    photos.map((photo) => (
      <a
        href={photo.src}
        target="_blank"
        rel="noopener"
        class="group grid w-fit"
      >
        <Image src={photo} alt="" class="col-start-1 row-start-1" />
        <div class="col-start-1 row-start-1 group-hover:bg-black/50 dark:group-hover:bg-white/50" />
      </a>
    ))
  }
</Layout>
